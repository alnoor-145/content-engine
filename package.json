{
  "name": "content-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Motion graphics content engine for YouTube and Facebook, built with Remotion.",
  "scripts": {
    "dev": "remotion studio",
    "typecheck": "tsc --noEmit",
    "render": "node scripts/render.mjs",
    "render:youtube": "remotion render YouTube-TitleCard out/youtube-title.mp4",
    "render:short": "remotion render Short-KineticText out/short-kinetic.mp4",
    "render:fb-square": "remotion render FB-Square-TitleCard out/fb-square-title.mp4",
    "render:fb-feed": "remotion render FB-Feed-KineticText out/fb-feed-kinetic.mp4",
    "new": "node scripts/new-video.mjs",
    "demo-audio": "node scripts/make-demo-audio.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@remotion/captions": "^4.0.545",
    "@remotion/cli": "^4.0.545",
    "@remotion/google-fonts": "^4.0.545",
    "@remotion/lottie": "^4.0.545",
    "@remotion/media-utils": "^4.0.545",
    "@remotion/paths": "^4.0.545",
    "@remotion/shapes": "^4.0.545",
    "@remotion/three": "^4.0.545",
    "@remotion/transitions": "^4.0.545",
    "lottie-web": "^5.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.545",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2"
  }
}
